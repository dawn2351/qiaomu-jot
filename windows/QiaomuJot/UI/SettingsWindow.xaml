<Window x:Class="QiaomuJot.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="乔木闪记 设置"
        Width="640" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F8"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E7" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Resources/icon.png" Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock Text="乔木闪记 · Jot 设置" FontSize="15" FontWeight="Bold" Foreground="#111111" />
                    <TextBlock Text="配置保存位置、全局快捷键与格式偏好" FontSize="11.5" Foreground="#777777" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Margin="14,10,14,10" Background="#FFFFFF" BorderBrush="#E5E5E7">
            <!-- Tab 1: Storage -->
            <TabItem Header="存储与仓库">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="保存位置" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbObsidian" Content="Obsidian 仓库" FontWeight="Medium" IsChecked="True" Margin="0,0,20,0" Checked="RbObsidian_Checked" />
                            <RadioButton x:Name="RbPlain" Content="普通 Markdown 文件夹" FontWeight="Medium" Checked="RbPlain_Checked" />
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtVaultPath" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Padding="6,0" FontSize="12.5" />
                            <Button Grid.Column="1" Content="浏览..." Width="70" Height="30" Margin="8,0,0,0" Click="BtnBrowseVault_Click" />
                        </Grid>

                        <TextBlock Text="已检测到的 Obsidian 仓库 (点击快速切换):" FontSize="12" Foreground="#666666" Margin="0,0,0,6" />
                        <ListBox x:Name="LstDiscoveredVaults" Height="80" Margin="0,0,0,14" SelectionChanged="LstDiscoveredVaults_SelectionChanged" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="日记与附件配置" />

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日记子文件夹:" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox x:Name="TxtDailyFolder" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                        </Grid>

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日记文件名格式:" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox x:Name="TxtDailyFormat" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                        </Grid>

                        <CheckBox x:Name="ChkPrependEntries" Content="新内容插入正文开头" Margin="0,4,0,4" />
                        <TextBlock Text="保留文档开头的 YAML 属性和一级标题。" Foreground="#666666" FontSize="11.5" Margin="0,0,0,8" />

                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="附件子文件夹:" VerticalAlignment="Center" FontSize="12.5" />
                            <TextBox x:Name="TxtAttachmentFolder" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Shortcuts -->
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="全局呼出快捷键" Margin="0,0,0,12" />

                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="随手记浮动窗口:" VerticalAlignment="Center" FontSize="13" />
                            <TextBox x:Name="TxtShortcutCapture" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="6,0" Text="Win+J" />
                            <TextBlock Grid.Column="2" Text="(对应 Mac ⌘⇧J，按 Win+J 弹出输入框)" VerticalAlignment="Center" Foreground="#888888" FontSize="11.5" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="一键收录选中内容:" VerticalAlignment="Center" FontSize="13" />
                            <TextBox x:Name="TxtShortcutQuickSave" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="6,0" Text="Win+K" />
                            <TextBlock Grid.Column="2" Text="(对应 Mac ⌘⇧K，按 Win+K 极速收录)" VerticalAlignment="Center" Foreground="#888888" FontSize="11.5" Margin="10,0,0,0" />
                        </Grid>

                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="截图/剪贴板文字识别:" VerticalAlignment="Center" FontSize="13" />
                            <TextBox x:Name="TxtShortcutScreenshotOcr" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="6,0" Text="Alt+Shift+S" />
                            <TextBlock Grid.Column="2" Text="(本地离线 OCR，收录图片与识别文字)" VerticalAlignment="Center" Foreground="#888888" FontSize="11.5" Margin="10,0,0,0" />
                        </Grid>

                        <Border Background="#F9F9FB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                            <TextBlock Text="💡 提示: 快捷键支持任意组合，修改后点击下方「保存」即可立即生效。" FontSize="12" Foreground="#666666" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Formatting & OCR -->
            <TabItem Header="格式与识别">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="写入日记样式" Margin="0,0,0,8" />
                        <ComboBox x:Name="CmbFormatStyle" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12" SelectionChanged="CmbFormatStyle_SelectionChanged">
                            <ComboBoxItem Content="原样保存（默认：内容 + 独立来源引用行）" Tag="verbatim" IsSelected="True" />
                            <ComboBoxItem Content="时间戳格式（**HH:mm** 内容）" Tag="timestamped" />
                            <ComboBoxItem Content="列表格式（- HH:mm 内容 · 来源）" Tag="list" />
                            <ComboBoxItem Content="引用块格式（> 内容 \n > — HH:mm）" Tag="quote" />
                        </ComboBox>

                        <TextBlock Text="格式实时预览:" FontSize="12" Foreground="#666666" Margin="0,0,0,4" />
                        <Border Background="#F8F8F9" BorderBrush="#E2E2E5" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                            <TextBlock x:Name="TxtFormatPreview" FontFamily="Consolas, Segoe UI" FontSize="12.5" LineHeight="18" Foreground="#2A2A2A" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="智能与离线能力" />
                        <CheckBox x:Name="ChkEnableOcr" Content="开启截图文字本地识别 (基于 Windows.Media.Ocr，完全离线且支持中英文)" FontWeight="Medium" Margin="0,4,0,8" />
                        <CheckBox x:Name="ChkPlaySound" Content="收录成功时播放提示音效" FontWeight="Medium" Margin="0,4,0,8" />
                        <CheckBox x:Name="ChkLaunchAtLogin" Content="开机自动启动并在系统托盘常驻" FontWeight="Medium" Margin="0,4,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: About -->
            <TabItem Header="关于">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Image Source="/Resources/icon.png" Width="64" Height="64" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="乔木闪记 · Jot" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#111111" />
                        <TextBlock Text="Windows 原生移植版 · v1.0.0" FontSize="12.5" Foreground="#777777" HorizontalAlignment="Center" Margin="0,4,0,14" />

                        <TextBlock Text="按一个快捷键，把灵感、选中文字和截图收进 Obsidian 或任意 Markdown 文件夹。" HorizontalAlignment="Center" Foreground="#444444" FontSize="13" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                            <Button Content="运行自检测试 (--selftest)" Padding="12,6" Margin="0,0,12,0" Click="BtnSelfTest_Click" />
                            <Button Content="查看开源项目主页" Padding="12,6" Click="BtnOpenGithub_Click" />
                        </StackPanel>

                        <TextBlock x:Name="TxtSelfTestResult" Text="" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="12.5" Margin="0,14,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E5E5E7" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存并应用" Width="96" Height="30" FontWeight="SemiBold" Background="#111111" Foreground="#FFFFFF" Click="BtnSaveSettings_Click" />
                <Button Content="取消" Width="70" Height="30" Margin="8,0,0,0" Click="BtnCancel_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
