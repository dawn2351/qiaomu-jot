<Window x:Class="QiaomuJot.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="乔木闪记 提示"
        Width="340" Height="74"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">

    <Border Background="#1E1E22" BorderBrush="#35353A" BorderThickness="1" CornerRadius="10" Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border Grid.Column="0" Width="26" Height="26" Background="#2A7334" CornerRadius="13" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="已收录到今日日记" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtDetail" Text="" FontSize="11.5" Foreground="#A0A0A5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Undo Button -->
            <Button Grid.Column="2" x:Name="BtnUndo" Content="撤销" FontSize="12" FontWeight="Medium"
                    Background="#2C2C30" Foreground="#E0E0E0" BorderThickness="0"
                    Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                    Click="BtnUndo_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3D3D44" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
