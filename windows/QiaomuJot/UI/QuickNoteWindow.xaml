<Window x:Class="QiaomuJot.UI.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="乔木闪记 · Jot"
        Width="600" MinHeight="260" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EAEAEA" />
                                <Setter Property="Foreground" Value="#111111" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DDDDDD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background" Value="#101010" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="#FCFCFC" BorderBrush="#E5E5E7" BorderThickness="1" CornerRadius="14"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header -->
                <RowDefinition Height="*" />     <!-- Editor / Preview -->
                <RowDefinition Height="Auto" />  <!-- Attachments preview -->
                <RowDefinition Height="Auto" />  <!-- Toolbar -->
                <RowDefinition Height="Auto" />  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="14,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/icon.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="乔木闪记" FontSize="13.5" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Destination Pill -->
                <Border Grid.Column="1" Margin="12,0,0,0" Background="#F1F1F3" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="12" Padding="8,3" Cursor="Hand" ToolTip="点击切换保存位置" MouseLeftButtonDown="DestPill_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📓 " FontSize="11" />
                        <TextBlock x:Name="TxtDest" Text="今日日记" FontSize="11.5" Foreground="#555555" FontWeight="Medium" />
                    </StackPanel>
                </Border>

                <!-- Action Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolBtn}" Content="⚙" ToolTip="设置" Click="BtnSettings_Click" Padding="6,2" FontSize="14" />
                    <Button Style="{StaticResource ToolBtn}" Content="✕" ToolTip="关闭 (保留草稿)" Click="BtnClose_Click" Padding="6,2" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- Editor / Preview Area -->
            <Grid Grid.Row="1" Margin="14,4,14,4" MinHeight="130">
                <!-- Watermark placeholder -->
                <TextBlock x:Name="TxtPlaceholder"
                           Text="随手记下灵感、粘贴截图或拖入文件... (Ctrl+Enter 保存, Esc 关闭)"
                           Foreground="#9E9EA7" FontSize="14" Margin="4,6,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Top" />

                <!-- Main Text Editor -->
                <TextBox x:Name="TxtInput"
                         Background="Transparent" BorderThickness="0"
                         FontSize="14" FontFamily="Segoe UI, Microsoft YaHei, Consolas"
                         Foreground="#1C1C1E"
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="TxtInput_TextChanged"
                         PreviewKeyDown="TxtInput_PreviewKeyDown"
                         AllowDrop="True" Drop="TxtInput_Drop" />

                <!-- Live Preview Overlay (toggleable) -->
                <Border x:Name="BorderPreview" Background="#FFFFFF" Visibility="Collapsed" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtPreviewContent" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#222222" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Attachment badge area -->
            <StackPanel x:Name="PanelAttachments" Grid.Row="2" Orientation="Horizontal" Margin="14,2,14,4" Visibility="Collapsed">
                <Border Background="#EBF3FF" BorderBrush="#BCD8F8" BorderThickness="1" CornerRadius="6" Padding="6,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtAttachmentInfo" Text="📷 截图已准备好 (带OCR文字)" FontSize="11" Foreground="#1A66C2" />
                        <Button Content="✕" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#888888" Cursor="Hand" Click="BtnRemoveAttachment_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Formatting Toolbar -->
            <Border Grid.Row="3" Margin="12,4,12,4" Padding="0,4" BorderBrush="#F0F0F2" BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolBtn}" Content="B" FontWeight="Bold" ToolTip="粗体 (Ctrl+B)" Click="BtnBold_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="I" FontStyle="Italic" ToolTip="斜体 (Ctrl+I)" Click="BtnItalic_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="H" ToolTip="标题 (Ctrl+1/2/3)" Click="BtnHeading_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="🔗" ToolTip="链接 (Ctrl+K)" Click="BtnLink_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="&lt;/&gt;" ToolTip="行内代码 (Ctrl+E)" Click="BtnCode_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="❝" ToolTip="引用" Click="BtnQuote_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="• 列表" ToolTip="列表项" Click="BtnList_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="☑ 待办" ToolTip="待办任务" Click="BtnTask_Click" />
                        <Button Style="{StaticResource ToolBtn}" Content="📷" ToolTip="添加本地图片" Click="BtnAddImage_Click" />
                        <Button x:Name="BtnTogglePreview" Style="{StaticResource ToolBtn}" Content="👁 预览" ToolTip="切换实时预览 (Ctrl+P)" Click="BtnTogglePreview_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="14,4,14,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCharCount" Text="0 字" FontSize="11.5" Foreground="#999999" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+Enter 保存 · Esc 关闭" FontSize="11.5" Foreground="#A0A0A5" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SaveBtn}" Content="保存到日记 ↵" Click="BtnSave_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
